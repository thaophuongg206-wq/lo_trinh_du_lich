# Optional external APIs
TOMTOM_API_KEY=
SERPAPI_KEY=
SERPAPI_MAX_CALLS=6
SERPAPI_TIMEOUT=12
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
ABSA_OLLAMA_ENABLED=0
OLLAMA_TIMEOUT=90
NARRATIVE_TIMEOUT=60

# Hybrid NSGA-II
HYBRID_POP_SIZE=40
HYBRID_GENERATIONS=60
TOMTOM_TIMEOUT=5

# OSRM
OSRM_BASE=http://router.project-osrm.org
OSRM_TIMEOUT=8

# --- OSRM cache / prefilter / Nominatim ---
OSRM_CACHE_PATH=osrm_cache.sqlite
PREFILTER_MAX=25
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=DuLichThongMinh/1.0 (your-email@example.com)
NOMINATIM_MIN_INTERVAL=1.0

